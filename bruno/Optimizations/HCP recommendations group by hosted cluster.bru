meta {
  name: HCP recommendations group by hosted cluster
  type: http
  seq: 234
}

get {
  url: {{baseURL}}/recommendations/openshift/hcp?group_by[hosted_cluster_id]=*&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Aggregate HCP recommendations per hosted cluster. Each row includes
  hosted_cluster_id, count (short/cost representative rows), and
  estimated_savings ({value, units} summed over pinned rows in display
  currency; meta.currency names the currency). Only associated rows appear;
  unassociated rows are excluded.
}

settings {
  encodeUrl: true
  timeout: 0
}
