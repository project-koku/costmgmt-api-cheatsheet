meta {
  name: HCP recommendations group by hosted cluster
  type: http
  seq: 234
}

get {
  url: {{baseURL}}/recommendations/openshift/hcp?group_by[hosted_cluster_id]=*&limit=20&offset=0
  body: none
  auth: inherit
}

headers {
  x-rh-identity: {{xRhIdentity}}
}

docs {
  Aggregate HCP recommendations per hosted cluster. Each row includes
  hosted_cluster_id and count (short/cost representative rows). Only
  associated rows appear; unassociated rows are excluded. Per-HC savings
  rollup is not yet available.
}

settings {
  encodeUrl: true
  timeout: 0
}
